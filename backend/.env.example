# ============================================================
# MDQA-System Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- API Settings ---
API_BASE_URL=http://localhost:8000

# --- Database Paths ---
SQLITE_PATH=data/sqlite/main.db
CHROMA_PERSIST_DIR=data/chroma
UPLOAD_DIR=uploads

# --- Cache Settings (Offline Mode) ---
# Models will be stored here. Absolute paths recommended if moving the app.
HF_HOME=models
SENTENCE_TRANSFORMERS_HOME=models

# --- LLM Model (GGUF via llama-cpp-python) ---
# The GGUF model will be auto-downloaded from Hugging Face on first run.
LLM_MODEL_REPO=TheBloke/LLaMA-Pro-8B-Instruct-GGUF
LLM_MODEL_FILE=llama-pro-8b-instruct.Q2_K.gguf
LLM_MODEL_TYPE=llama
LLM_GPU_LAYERS=-1
# -1 = auto-detect (offload all layers to GPU)
#  0 = CPU only
LLM_CONTEXT_SIZE=4096
LLM_MAX_TOKENS=512

# --- Embedding Model ---
# BAAI/bge-m3 is a high-quality multi-lingual model (~1.5GB)
DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3

# --- Re-ranker Model ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- RAG Configuration ---
DEFAULT_CHUNK_SIZE=200
DEFAULT_CHUNK_OVERLAP=40

# --- OCR Settings ---
OCR_ENABLED=true
PADDLEOCR_LANG=en
PADDLEOCR_USE_GPU=false

# --- Hugging Face Token (Optional) ---
# Only needed if using gated models.
# HF_TOKEN=""

# --- Voice / STT (Whisper) ---
# Speech-to-text model for voice input.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Voice / TTS (Kokoro-82M) ---
# Ultra-fast, high-quality TTS that runs in-process.
# Voices: af_heart, af_bella, af_nicole, af_sky (American Female)
#         am_adam, am_michael (American Male)
#         bf_emma, bf_isabella (British Female) 
#         bm_george, bm_lewis (British Male)
TTS_VOICE=af_heart
TTS_ENABLED=true
TTS_SPEED=1.0

# --- Memory Management ---
# Set to 0.0 to prevent PyTorch MPS from pre-allocating GPU memory aggressively
PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.0
