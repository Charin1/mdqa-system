# ============================================================
# MDQA-System Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- API Settings ---
API_BASE_URL=http://localhost:8000

# --- Database Paths ---
SQLITE_PATH=data/sqlite/main.db
CHROMA_PERSIST_DIR=data/chroma
UPLOAD_DIR=uploads

# --- LLM Model (GGUF via llama-cpp-python) ---
# The GGUF model will be auto-downloaded from Hugging Face on first run.
# Change these to swap to a different model without touching code.
LLM_MODEL_REPO=Qwen/Qwen3-8B-GGUF
LLM_MODEL_FILE=qwen3-8b-q4_k_m.gguf
LLM_GPU_LAYERS=-1
# -1 = auto-detect (offload all layers to GPU)
#  0 = CPU only
# 50 = offload 50 layers to GPU (for systems with limited VRAM)
LLM_CONTEXT_SIZE=4096
LLM_MAX_TOKENS=4096

# --- Embedding Model ---
# Lightweight embedding model (~80MB). Alternatives:
#   BAAI/bge-m3           (large, ~1.5GB, higher quality)
#   nomic-ai/nomic-embed-text-v2-moe  (medium, ~475M params)
#   BAAI/bge-small-en-v1.5 (tiny, ~130MB)
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Re-ranker Model ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- RAG Configuration ---
DEFAULT_CHUNK_SIZE=256
DEFAULT_CHUNK_OVERLAP=64

# --- OCR Settings ---
OCR_ENABLED=true
PADDLEOCR_LANG=en
PADDLEOCR_USE_GPU=false

# --- Hugging Face Token (Optional) ---
# Only needed if using gated models (e.g., Llama 3).
# Qwen3 does NOT require a token.
# HF_TOKEN=hf_YourTokenHere

# --- Voice / STT (Whisper) ---
# Speech-to-text model for voice input. Runs locally via faster-whisper.
# Model sizes: tiny (~75MB), base (~150MB), small (~500MB), medium (~1.5GB)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Voice / TTS (Voxtral) ---
# Text-to-speech model for reading answers aloud. Loaded on demand.
# WARNING: Requires ~8GB memory. Set TTS_ENABLED=false to disable.
TTS_MODEL=mistralai/Voxtral-4B-TTS-2603
TTS_VOICE=casual_male
TTS_ENABLED=true

# --- Memory Management ---
# Set to 0.0 to prevent PyTorch MPS from pre-allocating GPU memory aggressively
PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.0
